# Vectros examples — copy this file to `.env` and fill in your values.
# Create API keys from your Vectros dashboard. Docs: https://docs.vectros.ai

# Your live API key (looks like sk_live_…).
VECTROS_API_KEY=

# Your test-environment API key (looks like sk_test_…). Every Vectros account
# has both a live and a test key; this one drives the tenant-isolation examples.
# Leave it blank to skip those.
VECTROS_TEST_API_KEY=

# The Vectros API base URL.
VECTROS_API_BASE_URL=https://api.vectros.ai

# Your tenant id. Needed by every example that mints a scoped key against a
# specific app context — cross-context isolation, app-context teardown, access
# profiles, capabilities, token assume, erasure requests, invitations, identity,
# logs and deleted-user context refusal. Three of those skip the tests that need it
# when it is blank; the rest FAIL, so set it before running a full suite.
VECTROS_LIVE_TENANT_ID=

# Optional: the agent-runs examples (`runs` in the TypeScript examples, `agent_run` in the MCP examples) make real, billed agent runs, so they are skipped unless you set VECTROS_SMOKE_RUNS=1.
# It needs agent runs switched on for your account by its owner. If the key above belongs to a tenant where that switch is off,
# set VECTROS_RUN_SMOKE_API_KEY to a key for a tenant where it is on (the example then acts with that key).
# The `runs` example's charge checks assume a prepaid inference balance: use the key of a prepaid tenant for it.
# VECTROS_SMOKE_RUNS=1
# VECTROS_RUN_SMOKE_API_KEY=
# VECTROS_SMOKE_AGENT_MODEL=
# VECTROS_SMOKE_RUN_CONCURRENCY=1
